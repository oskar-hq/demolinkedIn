{
  "name": "outreach-cockpit-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/index.ts",
    "start": "node dist/server/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "check": "tsx --env-file-if-exists=../.env src/liveCheck.ts",
    "accounts": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/accountsCli.ts",
    "backup": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/backupCli.ts",
    "linkedin": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/linkedinCli.ts",
    "enrich": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/enrichCli.ts",
    "settings": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/settingsCli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
